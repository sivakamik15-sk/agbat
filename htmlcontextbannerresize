<template>
    <template for:each={banners} for:item="b">
        <div key={b.key} class={b.cssClass} role="alert"
             style="text-align:left; justify-content:left;">
            <lightning-icon icon-name="utility:warning" alternative-text="Warning!" variant="warning"
                            style="margin-right: 2%;"></lightning-icon>
            <lightning-formatted-rich-text value={b.message}></lightning-formatted-rich-text>
        </div>
    </template>
</template>
