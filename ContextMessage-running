// 1. How many active rules exist, broken down by object
Map<String, Integer> counts = new Map<String, Integer>();
for (RuleCriteria__mdt rc : [SELECT ForObject__r.ObjectAPIName__c
                             FROM RuleCriteria__mdt
                             WHERE isActive__c = true]) {
    String obj = rc.ForObject__r.ObjectAPIName__c;
    counts.put(obj, counts.containsKey(obj) ? counts.get(obj) + 1 : 1);
}
System.debug('### Active rules per object: ' + counts);
