Map<String, Integer> counts = new Map<String, Integer>();

List<String> fields = new List<String>();
fields.add('LSW_Life_Agent_Number__c');
fields.add('Global_Agent_ID__c');
fields.add('PartyIdentifier__c');
fields.add('MailingPostalCode');
fields.add('PolicyNumber__c');
fields.add('PolicyGroup__c');
fields.add('ProductName__c');
fields.add('AgencyNumber__c');
fields.add('SystemCode__c');
fields.add('isEmailBounced');
fields.add('RecordTypeId');
fields.add('AccountId');
fields.add('Policy__c');
fields.add('Role__c');
fields.add('Name');

for (RuleCriteria__mdt rc : [SELECT Label, Query__c, ForObject__r.Label
                             FROM RuleCriteria__mdt WHERE isActive__c = true]) {
    if (String.isBlank(rc.Query__c)) { continue; }

    String clause = rc.Query__c.toLowerCase();
    Integer at = clause.indexOf('where');
    if (at > 0) { clause = clause.substring(at); }

    for (String f : fields) {
        if (clause.contains(f.toLowerCase())) {
            String key = rc.ForObject__r.Label + ' - ' + f;
            Integer n = counts.containsKey(key) ? counts.get(key) : 0;
            counts.put(key, n + 1);
            clause = clause.replace(f.toLowerCase(), 'x');
        }
    }
}

for (String k : counts.keySet()) {
    System.debug('RESULT ' + k + ' = ' + counts.get(k));
}
