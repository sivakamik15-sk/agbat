/**
 * ContextualBannerController
 *
 * The only class the LWC calls. One entry point that sends the request to the
 * right method by object:
 *
 *   PolicyMaster__c page -> ContextualBannerHelper.getPolicyRules()   CTX_POLICY_* files
 *   Contact page         -> ContextualBannerHelper.getContactRules()  CTX_CONTACT_* files
 *
 * Each of those reads only its own files, so nothing is loaded and then
 * filtered. The rules come back with their lists of records; the LWC does the
 * comparison with the record being viewed.
 *
 * The method takes no record Id, so the result is the same for every record of
 * an object and the browser can cache it.
 *
 * A failure returns an empty list rather than an error, so the page is never
 * broken by the banner.
 */
public with sharing class ContextualBannerController {

    // Only Customer contacts show the banners of their policies. Agent contacts
    // do not. This is the Developer Name of the Contact record type (Setup >
    // Object Manager > Contact > Record Types), not the label.
    private static final String CUSTOMER_RECORD_TYPE = 'Customer';

    @AuraEnabled(cacheable=true)
    public static List<ContextualBannerHelper.Rule> getRules(String objectApiName) {

        List<ContextualBannerHelper.Rule> empty = new List<ContextualBannerHelper.Rule>();

        try {
            if (objectApiName == 'PolicyMaster__c') {
                return ContextualBannerHelper.getPolicyRules();
            }
            if (objectApiName == 'Contact') {
                return ContextualBannerHelper.getContactRules();
            }
            return empty;                       // any other object has no config files

        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR,
                'ContextualBanner - getRules failed for ' + objectApiName
                + ': ' + e.getMessage());
            return empty;
        }
    }

    /**
     * The policy numbers of the policies linked to a Customer contact (through
     * PolicyContact__c). The LWC uses them on the Contact page, so a customer shows
     * the same banners as its policies. An Agent contact gets an empty list.
     * One query, whatever the number of rules.
     */
    @AuraEnabled(cacheable=true)
    public static List<String> getContactPolicyNumbers(Id contactId) {

        List<String> policyNumbers = new List<String>();
        if (contactId == null) {
            return policyNumbers;
        }

        try {
            for (PolicyContact__c link : [
                    SELECT Policy__r.PolicyNumber__c
                    FROM PolicyContact__c
                    WHERE Contact__c = :contactId
                    AND Contact__r.RecordType.DeveloperName = :CUSTOMER_RECORD_TYPE]) {
                String policyNumber = (link.Policy__r == null)
                    ? null : link.Policy__r.PolicyNumber__c;
                if (String.isNotBlank(policyNumber)) {
                    policyNumbers.add(policyNumber);
                }
            }
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR,
                'ContextualBanner - getContactPolicyNumbers failed: ' + e.getMessage());
        }
        return policyNumbers;
    }
}
