/**
 * Tests for the banner classes.
 *
 * Static resources cannot be created from Apex, so rules are built from sample text with
 * parseRule() and checked with prepare(); the lookups are run against records that do not
 * exist, which proves the queries are valid and cost what they should. The query counts
 * of the file loading are tested against whatever config files exist in the org.
 *
 * These tests use the real objects and fields of the org (PolicyMaster__c, Contact,
 * PolicyContact__c), so they also prove the fields used by the sample rule files exist in the org.
 */
@isTest
private class ContextualBannerControllerTest {

    private static final String VALID =
        '{"message":"Banner text","description":"Why","policyRecords":["LS001","LS002"]}';

    private static final Id NO_POLICY =
        (Id) (PolicyMaster__c.SObjectType.getDescribe().getKeyPrefix() + '000000000001');
    private static final Id NO_CONTACT =
        (Id) (Contact.SObjectType.getDescribe().getKeyPrefix() + '000000000001');

    /** A rule as it would be read from a file, and checked for the given page. Null if rejected. */
    private static ContextualBannerHelper.Rule prepared(String fileName, String json, String page) {
        ContextualBannerHelper.Rule r = ContextualBannerHelper.parseRule(fileName, json);
        System.assertNotEquals(null, r, 'the sample file must parse: ' + fileName);
        return ContextualBannerHelper.prepare(r, page) ? r : null;
    }

    private static String withCriteria(String criteria, String records) {
        return '{"message":"m","criteria":' + criteria + ',"policyRecords":' + records + '}';
    }

    // the same criteria the sample rule files use
    private static final String LINK_POLICY  = '{"objectApiName":"PolicyContact__c","linkField":"Policy__c"}';
    private static final String LINK_CONTACT = '{"objectApiName":"PolicyContact__c","linkField":"Contact__c"}';
    private static final String CONTACT_POSTCODE =
        '{"related":' + LINK_POLICY + ',"field":"Contact__r.MailingPostalCode","match":"startsWith"}';
    private static final String CONTACT_NAME =
        '{"related":' + LINK_POLICY + ',"field":"Contact__r.Name"}';
    private static final String PRODUCT = '{"field":"ProductName__c"}';
    private static final String POLICY_NUMBERS_OF_A_CONTACT =
        '{"related":' + LINK_CONTACT + ',"field":"Policy__r.PolicyNumber__c"}';
    private static final String POLICY_GROUPS_OF_A_CONTACT =
        '{"related":' + LINK_CONTACT + ',"field":"Policy__r.PolicyGroup__c"}';
    private static final String ANNUITANT_POLICIES =
        '{"related":{"objectApiName":"PolicyContact__c","linkField":"Contact__c",'
        + '"filters":[{"field":"Role__c","value":"Annuitant"}]},"field":"Policy__c","match":"id"}';

    // -------------------------------------------- policy and contact separate

    @isTest
    static void policyAndContactUseTheirOwnPrefix() {
        System.assertEquals('CTX_POLICY_',  ContextualBannerHelper.POLICY_PREFIX);
        System.assertEquals('CTX_CONTACT_', ContextualBannerHelper.CONTACT_PREFIX);
        System.assertEquals('CTX_POLICY_',  ContextualBannerHelper.prefixFor('PolicyMaster__c'));
        System.assertEquals('CTX_CONTACT_', ContextualBannerHelper.prefixFor('Contact'));
        System.assertEquals(null, ContextualBannerHelper.prefixFor('Account'));
    }

    @isTest
    static void eachObjectIsLoadedWithItsOwnQuery() {
        Test.startTest();
        List<ContextualBannerHelper.Rule> policy = ContextualBannerHelper.getPolicyRules();
        Integer afterPolicy = Limits.getQueries();
        List<ContextualBannerHelper.Rule> contact = ContextualBannerHelper.getContactRules();
        Integer afterContact = Limits.getQueries();
        Test.stopTest();

        System.assertNotEquals(null, policy);
        System.assertNotEquals(null, contact);
        System.assertEquals(1, afterPolicy,  'policy rules cost exactly one query');
        System.assertEquals(2, afterContact, 'contact rules cost one more - each object has its own query');
    }

    // -------------------------------------------------------------- parsing

    @isTest
    static void validFileBecomesARule() {
        ContextualBannerHelper.Rule r = ContextualBannerHelper.parseRule('CTX_POLICY_001', VALID);

        System.assertNotEquals(null, r, 'a valid file must produce a rule');
        System.assertEquals('CTX_POLICY_001', r.name);
        System.assertEquals('Banner text', r.message);
        System.assertEquals('Why', r.description);
        System.assertEquals(2, r.policyRecords.size());
    }

    @isTest
    static void byteOrderMarkIsTolerated() {
        String bom = String.fromCharArray(new List<Integer>{ 65279 });

        System.assertNotEquals(null,
            ContextualBannerHelper.parseRule('CTX_POLICY_001', bom + VALID),
            'a leading byte order mark must not break parsing');
    }

    @isTest
    static void oldArrayFormatIsRejected() {
        String oldFormat = '[' + VALID + ']';

        System.assertEquals(null,
            ContextualBannerHelper.parseRule('CTX_POLICY_001', oldFormat),
            'one rule per file - an array of rules is not accepted');
    }

    @isTest
    static void incompleteFilesAreRejected() {
        System.assertEquals(null, ContextualBannerHelper.parseRule('F', null));
        System.assertEquals(null, ContextualBannerHelper.parseRule('F', ''));
        System.assertEquals(null, ContextualBannerHelper.parseRule('F', 'not json'));
        System.assertEquals(null, ContextualBannerHelper.parseRule('F',
            '{"description":"d","policyRecords":["A"]}'), 'message is required');
        System.assertEquals(null, ContextualBannerHelper.parseRule('F',
            '{"message":"m","description":"d","policyRecords":[]}'), 'records are required');
        System.assertEquals(null, ContextualBannerHelper.parseRule('F',
            '{"message":"m","description":"d"}'), 'records are required');
    }

    @isTest
    static void descriptionIsOptional() {
        System.assertNotEquals(null, ContextualBannerHelper.parseRule('F',
            '{"message":"m","policyRecords":["A"]}'));
    }

    @isTest
    static void excludeListIsOptional() {
        ContextualBannerHelper.Rule withList = ContextualBannerHelper.parseRule('CTX_POLICY_AGENCY_001',
            '{"message":"m","policyRecords":["3NP"],"excludeRecords":["1229214X","1229215X"]}');
        System.assertNotEquals(null, withList);
        System.assertEquals(2, withList.excludeRecords.size());

        ContextualBannerHelper.Rule without = ContextualBannerHelper.parseRule('CTX_POLICY_AGENCY_002', VALID);
        System.assertNotEquals(null, without, 'a file without excludeRecords is still valid');
        System.assertEquals(null, without.excludeRecords);
    }

    // ----------------------------------------------------------- query count

    @isTest
    static void loadingAllFilesOfAnObjectCostsOneQuery() {
        Test.startTest();
        List<ContextualBannerHelper.Rule> rules =
            ContextualBannerHelper.loadRules(ContextualBannerHelper.POLICY_PREFIX);
        Integer used = Limits.getQueries();
        Test.stopTest();

        System.assertNotEquals(null, rules);
        System.assertEquals(1, used,
            'all files of an object must be read with exactly one query, used: ' + used);
    }

    @isTest
    static void blankPrefixLoadsNothingAndCostsNothing() {
        Test.startTest();
        List<ContextualBannerHelper.Rule> rules = ContextualBannerHelper.loadRules((String) null);
        Integer used = Limits.getQueries();
        Test.stopTest();

        System.assertEquals(0, rules.size());
        System.assertEquals(0, used, 'nothing to look up, so no query');
    }

    @isTest
    static void twoPrefixesNeedBothToBeSet() {
        Test.startTest();
        System.assertEquals(0, ContextualBannerHelper.loadRules('CTX_POLICY_', null).size());
        System.assertEquals(0, ContextualBannerHelper.loadRules('CTX_POLICY_', 'CTX_CONTACT_', null).size());
        System.assertEquals(0, Limits.getQueries(), 'nothing to look up, so no query');
        Test.stopTest();
    }

    @isTest
    static void anyNumberOfPrefixesStillCostsOneQuery() {
        Test.startTest();
        ContextualBannerHelper.loadRules(new List<String>{ 'CTX_POLICY_', 'CTX_CONTACT_' });
        System.assertEquals(1, Limits.getQueries(), 'several prefixes must be read with one query');
        System.assertEquals(0, ContextualBannerHelper.loadRules(new List<String>()).size());
        System.assertEquals(0, ContextualBannerHelper.loadRules(new List<String>{ 'CTX_POLICY_', '' }).size());
        System.assertEquals(1, Limits.getQueries(), 'a blank prefix means no query');
        Test.stopTest();
    }

    @isTest
    static void eachPageReadsOnlyItsOwnFiles() {
        for (ContextualBannerHelper.Rule r : ContextualBannerHelper.getPolicyRules()) {
            System.assert(r.name.startsWithIgnoreCase('CTX_POLICY_'), 'policy page file: ' + r.name);
        }
        for (ContextualBannerHelper.Rule r : ContextualBannerHelper.getContactRules()) {
            System.assert(r.name.startsWithIgnoreCase('CTX_CONTACT_'), 'contact page file: ' + r.name);
        }
    }

    // ------------------------------------------------------------ controller

    @isTest
    static void controllerRoutesByObject() {
        Test.startTest();

        // an unsupported object has no config files and costs no query
        System.assertEquals(0, ContextualBannerController.getRules('Account').size());
        System.assertEquals(0, ContextualBannerController.getRules(null).size());
        System.assertEquals(0, Limits.getQueries(), 'unsupported objects must not query');

        // each supported object runs exactly one query, for its own files only
        System.assertNotEquals(null, ContextualBannerController.getRules('PolicyMaster__c'));
        System.assertEquals(1, Limits.getQueries(), 'a Policy page costs one query');

        System.assertNotEquals(null, ContextualBannerController.getRules('Contact'));
        System.assertEquals(2, Limits.getQueries(), 'a Contact page costs one more');

        Test.stopTest();
    }

    // ------------------------------- every kind of rule is only a file with criteria

    @isTest
    static void everyKindOfPolicyRuleIsAcceptedFromItsCriteriaAlone() {
        List<String> ownField = new List<String>{
            '{"field":"PolicyNumber__c"}', '{"field":"PolicyGroup__c"}', '{"field":"ProductName__c"}',
            '{"field":"SystemCode__c"}', '{"field":"AgencyNumber__c","excludeField":"Name"}' };
        for (Integer i = 0; i < ownField.size(); i++) {
            ContextualBannerHelper.Rule r = prepared('CTX_POLICY_Own' + i, withCriteria(ownField[i], '["A"]'), 'PolicyMaster__c');
            System.assertNotEquals(null, r, ownField[i] + ' must be accepted');
            System.assertEquals(null, r.criteria.related, ownField[i] + ' compares the policy itself');
        }
        List<String> related = new List<String>{ CONTACT_POSTCODE, CONTACT_NAME,
            '{"related":' + LINK_POLICY + ',"field":"Contact__r.Account.Name"}' };
        for (Integer i = 0; i < related.size(); i++) {
            ContextualBannerHelper.Rule r = prepared('CTX_POLICY_Related' + i, withCriteria(related[i], '["A"]'), 'PolicyMaster__c');
            System.assertNotEquals(null, r, related[i] + ' must be accepted');
            System.assertNotEquals(null, r.criteria.related, related[i] + ' looks at the linked contacts');
        }
    }

    @isTest
    static void everyKindOfContactRuleIsAcceptedFromItsCriteriaAlone() {
        List<String> ownField = new List<String>{
            '{"field":"Global_Agent_ID__c"}', '{"field":"LSW_Life_Agent_Number__c"}',
            '{"field":"MailingPostalCode","match":"startsWith"}', '{"field":"Name"}',
            '{"field":"PartyIdentifier__c"}', '{"field":"IsEmailBounced"}',
            '{"field":"AccountId","match":"id"}', '{"field":"Id","match":"id"}' };
        for (Integer i = 0; i < ownField.size(); i++) {
            ContextualBannerHelper.Rule r = prepared('CTX_CONTACT_Own' + i, withCriteria(ownField[i], '["A"]'), 'Contact');
            System.assertNotEquals(null, r, ownField[i] + ' must be accepted');
            System.assertEquals(null, r.criteria.related, ownField[i] + ' compares the contact itself');
        }
        List<String> related = new List<String>{ POLICY_GROUPS_OF_A_CONTACT, POLICY_NUMBERS_OF_A_CONTACT, ANNUITANT_POLICIES };
        for (Integer i = 0; i < related.size(); i++) {
            ContextualBannerHelper.Rule r = prepared('CTX_CONTACT_Related' + i, withCriteria(related[i], '["A"]'), 'Contact');
            System.assertNotEquals(null, r, related[i] + ' must be accepted');
            System.assertEquals('Contact__c', r.criteria.related.linkField);
        }
        ContextualBannerHelper.Rule annuitant = prepared('CTX_CONTACT_Annuitant', withCriteria(ANNUITANT_POLICIES, '["A"]'), 'Contact');
        System.assertEquals(1, annuitant.criteria.related.filters.size());
        System.assertEquals('Role__c', annuitant.criteria.related.filters[0].field);
        System.assertEquals('id', annuitant.criteria.match);
    }

    @isTest
    static void theExcludeFieldIsKept() {
        ContextualBannerHelper.Rule r = prepared('CTX_POLICY_X',
            withCriteria('{"field":"AgencyNumber__c","excludeField":"name"}', '["A"]'), 'PolicyMaster__c');
        System.assertEquals('Name', r.criteria.excludeField);
    }

    @isTest
    static void aFileWithNoCriteriaIsSkippedWhateverItsName() {
        // no field name is kept in code, so a file must say which field it compares
        System.assertEquals(null, prepared('CTX_POLICY_POLICYNUMBER_001', VALID, 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_CONTACT_PARTYID_001', VALID, 'Contact'));
        System.assertEquals(null, prepared('CTX_POLICY_SOMETHINGNEW', VALID, 'PolicyMaster__c'));
    }

    // -------------------------------------- a new rule is a new file: criteria in the file

    @isTest
    static void theFileNameAfterThePagePrefixIsFreeText() {
        ContextualBannerHelper.Rule r = prepared('CTX_POLICY_MyTeamsOwnRuleName_X1DE_Policy1',
            withCriteria('{"field":"ProductName__c"}', '["A"]'), 'PolicyMaster__c');

        System.assertNotEquals(null, r, 'any name after CTX_POLICY_ is fine when the file has its criteria');
        System.assertEquals('ProductName__c', r.criteria.field);
        System.assertEquals('equals', r.criteria.match, 'equals is the default');
    }

    @isTest
    static void fieldAndMatchAreCheckedCaseInsensitivelyAndSpelledCanonically() {
        ContextualBannerHelper.Rule r = prepared('CTX_POLICY_X',
            withCriteria('{"field":"productname__c","match":"STARTSWITH"}', '["A"]'), 'PolicyMaster__c');

        System.assertNotEquals(null, r);
        System.assertEquals('ProductName__c', r.criteria.field, 'the name is rewritten as the org spells it');
        System.assertEquals('startsWith', r.criteria.match);
    }

    @isTest
    static void aFieldThatDoesNotExistSkipsOnlyThatRule() {
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"field":"No_Such_Field__c"}', '["A"]'), 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"field":""}', '["A"]'), 'PolicyMaster__c'));
        // the next rule is unaffected
        System.assertNotEquals(null, prepared('CTX_POLICY_Y',
            withCriteria('{"field":"PolicyNumber__c"}', '["A"]'), 'PolicyMaster__c'));
    }

    @isTest
    static void anUnknownMatchTypeIsSkipped() {
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"field":"PolicyNumber__c","match":"contains"}', '["A"]'), 'PolicyMaster__c'));
    }

    @isTest
    static void aDottedPathOnTheOwnRecordIsReadThroughALookup() {
        ContextualBannerHelper.Rule r = prepared('CTX_CONTACT_AccountName',
            withCriteria('{"field":"account.name"}', '["Acme"]'), 'Contact');

        System.assertNotEquals(null, r);
        System.assertEquals('Account.Name', r.criteria.field);
        System.assertEquals('Contact', r.criteria.related.objectApiName);
        System.assertEquals('Id', r.criteria.related.linkField);
    }

    @isTest
    static void relatedRecordsCanBeNamedInTheFile() {
        ContextualBannerHelper.Rule r = prepared('CTX_POLICY_ContactsAccount',
            withCriteria('{"related":{"objectApiName":"policycontact__c","linkField":"policy__c"},'
                + '"field":"Contact__r.Account.Name"}', '["Acme"]'), 'PolicyMaster__c');

        System.assertNotEquals(null, r, 'a field two lookups away must be accepted');
        System.assertEquals('PolicyContact__c', r.criteria.related.objectApiName);
        System.assertEquals('Policy__c', r.criteria.related.linkField);
        System.assertEquals('Contact__r.Account.Name', r.criteria.field);
    }

    @isTest
    static void aLinkThatDoesNotPointAtThePageObjectIsSkipped() {
        // PolicyContact__c.Contact__c points at Contact, not at the policy
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"PolicyContact__c","linkField":"Contact__c"},'
                + '"field":"Policy__c"}', '["A"]'), 'PolicyMaster__c'));
        // a link that is not a lookup at all
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"PolicyContact__c","linkField":"Role__c"},'
                + '"field":"Policy__c"}', '["A"]'), 'PolicyMaster__c'));
        // a path is not a link
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"PolicyContact__c","linkField":"Policy__r.Id"},'
                + '"field":"Policy__c"}', '["A"]'), 'PolicyMaster__c'));
    }

    @isTest
    static void aRelatedObjectOrFieldThatDoesNotExistIsSkipped() {
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"No_Such_Object__c","linkField":"Policy__c"},'
                + '"field":"Name"}', '["A"]'), 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"PolicyContact__c","linkField":"Policy__c"},'
                + '"field":"Contact__r.No_Such_Field__c"}', '["A"]'), 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"PolicyContact__c","linkField":"Policy__c"},'
                + '"field":"NotALookup__r.Name"}', '["A"]'), 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"related":{"objectApiName":"PolicyContact__c","linkField":"Policy__c"},'
                + '"field":"Policy__c"}', '["A"]').replace('"linkField":"Policy__c"',
                '"linkField":"Policy__c","filters":[{"field":"No_Such__c","value":"x"}]'), 'PolicyMaster__c'));
    }

    @isTest
    static void theExcludeFieldMustExistOnThePageRecord() {
        System.assertNotEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"field":"AgencyNumber__c","excludeField":"name"}', '["A"]'), 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"field":"AgencyNumber__c","excludeField":"No_Such__c"}', '["A"]'), 'PolicyMaster__c'));
        System.assertEquals(null, prepared('CTX_POLICY_X',
            withCriteria('{"field":"AgencyNumber__c","excludeField":"Owner.Name"}', '["A"]'), 'PolicyMaster__c'));
    }

    @isTest
    static void rulesOfTheSameKindShareOneShape() {
        ContextualBannerHelper.Rule a = prepared('CTX_POLICY_ContactPostcode', withCriteria(CONTACT_POSTCODE, '["A"]'), 'PolicyMaster__c');
        ContextualBannerHelper.Rule b = prepared('CTX_POLICY_AnotherPostcodeRule', withCriteria(
            '{"related":{"objectApiName":"PolicyContact__c","linkField":"policy__c"},'
            + '"field":"contact__r.mailingpostalcode","match":"startsWith"}', '["99"]'), 'PolicyMaster__c');
        ContextualBannerHelper.Rule other = prepared('CTX_POLICY_ContactName', withCriteria(CONTACT_NAME, '["A"]'), 'PolicyMaster__c');

        System.assertEquals(a.criteria.shape, b.criteria.shape, 'same kind of criterion - one lookup');
        System.assertNotEquals(a.criteria.shape, other.criteria.shape, 'a different field is a different lookup');
    }

    @isTest
    static void aFieldNoCodeEverMentionedIsAcceptedFromTheFileAlone() {
        // Description and CreatedDate are not named anywhere in the classes or the component
        ContextualBannerHelper.Rule r = prepared('CTX_CONTACT_AnythingAtAll',
            withCriteria('{"field":"Description","match":"startsWith"}', '["A"]'), 'Contact');
        System.assertNotEquals(null, r, 'a field the code has never heard of is accepted from the file alone');
        System.assertEquals('Description', r.criteria.field);
    }

    @isTest
    static void usableRulesFromTheOrgAllHaveCheckedCriteria() {
        for (ContextualBannerHelper.Rule r : ContextualBannerHelper.getPolicyRules()) {
            System.assertNotEquals(null, r.criteria, r.name);
            System.assertNotEquals(null, r.criteria.shape, r.name);
        }
        for (ContextualBannerHelper.Rule r : ContextualBannerHelper.getContactRules()) {
            System.assertNotEquals(null, r.criteria, r.name);
            System.assertNotEquals(null, r.criteria.shape, r.name);
        }
    }

    // ------------------------------------------------------------ related lookups

    @isTest
    static void postcodeLookupCostsOneQueryAndNeverFails() {
        List<ContextualBannerHelper.Rule> rules = new List<ContextualBannerHelper.Rule>{
            prepared('CTX_POLICY_ContactPostcode', withCriteria(CONTACT_POSTCODE, '["A"]'), 'PolicyMaster__c') };

        Test.startTest();
        System.assertEquals(0, ContextualBannerController.valuesFor(NO_POLICY, 'CTX_POLICY_ContactPostcode', rules).size());
        System.assertEquals(1, Limits.getQueries(), 'one lookup, however many rules share it');
        Test.stopTest();
    }

    @isTest
    static void listedValuesLookupCostsOneQueryAndNeverFails() {
        // policy numbers of a contact's policies - asked for by the listed values
        List<ContextualBannerHelper.Rule> rules = new List<ContextualBannerHelper.Rule>{
            prepared('CTX_CONTACT_PolicyNumbers', withCriteria(POLICY_NUMBERS_OF_A_CONTACT, '["LS001","LS002"]'), 'Contact') };

        Test.startTest();
        System.assertEquals(0, ContextualBannerController.valuesFor(NO_CONTACT, 'CTX_CONTACT_PolicyNumbers', rules).size());
        System.assertEquals(1, Limits.getQueries(), 'the policy numbers cost exactly one query');
        Test.stopTest();
    }

    @isTest
    static void groupedLookupCostsOneQueryAndNeverFails() {
        // equals with a very long list falls back to the distinct values of the field
        List<String> many = new List<String>();
        for (Integer i = 0; i < 1001; i++) { many.add('"G' + i + '"'); }
        List<ContextualBannerHelper.Rule> rules = new List<ContextualBannerHelper.Rule>{
            prepared('CTX_CONTACT_PolicyGroups',
                withCriteria(POLICY_GROUPS_OF_A_CONTACT, '[' + String.join(many, ',') + ']'), 'Contact') };

        Test.startTest();
        System.assertEquals(0, ContextualBannerController.valuesFor(NO_CONTACT, 'CTX_CONTACT_PolicyGroups', rules).size());
        System.assertEquals(1, Limits.getQueries(), 'the policy groups cost exactly one query');
        Test.stopTest();
    }

    @isTest
    static void annuitantLookupUsesTheRoleFilterAndOnlyRealIds() {
        String aPolicyId = PolicyMaster__c.SObjectType.getDescribe().getKeyPrefix() + '000000000001';
        List<ContextualBannerHelper.Rule> rules = new List<ContextualBannerHelper.Rule>{
            prepared('CTX_CONTACT_Annuitant1',
                withCriteria(ANNUITANT_POLICIES, '["' + aPolicyId + '"]'), 'Contact') };

        Test.startTest();
        System.assertEquals(0, ContextualBannerController.valuesFor(NO_CONTACT, 'CTX_CONTACT_Annuitant1', rules).size());
        System.assertEquals(1, Limits.getQueries(), 'the annuitant policies cost exactly one query');
