                withCriteria(ANNUITANT_POLICIES, '["not an id"]'), 'Contact') };
        Integer before = Limits.getQueries();
        System.assertEquals(0, ContextualBannerController.valuesFor(NO_CONTACT, 'CTX_CONTACT_Annuitant2', notIds).size());
        System.assertEquals(before, Limits.getQueries(), 'values that are not Ids cost no query');
    }

