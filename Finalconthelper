/**
 * ContextualBannerHelper
 *
 * Reads the banner rules from static resources.
 *
 * ONE RULE PER FILE
 *   Every static resource holds exactly one rule, so a mistake in one file
 *   can never affect another rule.
 *
 *   {
 *     "message": "text shown in the banner (HTML allowed)",
 *     "description": "why the rule exists - never displayed",
 *     "policyRecords": ["value1", "value2"]
 *   }
 *
 *   A rule may also have an optional "excludeRecords" list: records in it never show
 *   the banner even when they match policyRecords (used by the CTX_AGENCY_ rules).
 *
 * NAMING CONVENTION  (the first two words decide which page a file belongs to)
 *   Policy page   ->  CTX_POLICY_<TYPE>_001, ...   POLICYNUMBER, POLICYGROUP, POSTCODE, CONTACTNAME,
 *                                                  PRODUCT, AGENCY, SYSTEMCODE
 *   Contact page  ->  CTX_CONTACT_<TYPE>_001, ...  GLOBALAGENT, LSWAGENT, POSTCODE, CONTACTNAME,
 *                                                  PARTYID, EMAILBOUNCED, ACCOUNT, ID,
 *                                                  POLICYGROUP, POLICYNUMBER, ANNUITANT
 *   A Policy page loads every CTX_POLICY_ file, a Contact page every CTX_CONTACT_ file.
 *   The LWC reads the <TYPE> to know what to compare; a file with an unknown <TYPE>
 *   shows no banner (the LWC logs it).
 *
 * SOQL COST
 *   ONE query for all the files of an object, however many files there are.
 *   The comparison with the record happens in the LWC, not here.
 */
public with sharing class ContextualBannerHelper {

    /** One rule = one file. What the LWC receives. */
    public class Rule {
        @AuraEnabled public String name;                 // static resource name - set here, not in the file
        @AuraEnabled public String message;
        @AuraEnabled public String description;
        @AuraEnabled public List<String> policyRecords;
        @AuraEnabled public List<String> excludeRecords; // optional - records that never show the banner
    }

    /** The name prefix decides which page a config file belongs to. */
    public static final String POLICY_PREFIX  = 'CTX_POLICY_';
    public static final String CONTACT_PREFIX = 'CTX_CONTACT_';

    /** Rules for PolicyMaster__c pages - every CTX_POLICY_* file, read with ONE query. */
    public static List<Rule> getPolicyRules() {
        return loadRules(POLICY_PREFIX);
    }

    /** Rules for Contact pages - reads ONLY the CTX_CONTACT_* files. */
    public static List<Rule> getContactRules() {
        return loadRules(CONTACT_PREFIX);
    }

    /**
     * Loads every rule whose static resource name starts with the prefix.
     * ONE SOQL query. A bad file is skipped and logged, never fatal.
     */
    public static List<Rule> loadRules(String prefix) {
        return loadRules(new List<String>{ prefix });
    }

    /** Same, for two prefixes - still ONE query. */
    public static List<Rule> loadRules(String prefix, String otherPrefix) {
        return loadRules(new List<String>{ prefix, otherPrefix });
    }

    /** Same, for three prefixes - still ONE query. */
    public static List<Rule> loadRules(String prefix, String otherPrefix, String thirdPrefix) {
        return loadRules(new List<String>{ prefix, otherPrefix, thirdPrefix });
    }

    /**
     * Same, for any number of prefixes - still ONE query. If any prefix is
     * blank nothing is looked up.
     */
    public static List<Rule> loadRules(List<String> prefixes) {

        List<Rule> rules = new List<Rule>();
        if (prefixes == null || prefixes.isEmpty()) { return rules; }

        // one LIKE condition per prefix, each with its own bind variable
        List<String> conditions = new List<String>();
        Map<String, Object> binds = new Map<String, Object>();
        for (Integer i = 0; i < prefixes.size(); i++) {
            if (String.isBlank(prefixes[i])) { return rules; }
            conditions.add('Name LIKE :p' + i);
            binds.put('p' + i, prefixes[i] + '%');
        }

        List<StaticResource> files = Database.queryWithBinds(
            'SELECT Name, Body FROM StaticResource WHERE '
                + String.join(conditions, ' OR ') + ' ORDER BY Name',
            binds,
            AccessLevel.SYSTEM_MODE
        );

        for (StaticResource file : files) {
            // in LIKE an underscore matches any single character, so confirm
            // the name really starts with one of the prefixes
            Boolean wanted = false;
            for (String prefix : prefixes) {
                if (file.Name.startsWithIgnoreCase(prefix)) { wanted = true; break; }
            }
            if (!wanted) { continue; }

            String raw = (file.Body == null) ? null : file.Body.toString();
            Rule r = parseRule(file.Name, raw);
            if (r != null) { rules.add(r); }
        }

        System.debug('ContextualBanner - ' + rules.size() + ' valid rule(s) from '
            + files.size() + ' file(s) matching ' + String.join(prefixes, '%, ') + '%');

        return rules;
    }

    /**
     * Turns the text of one file into a Rule, or returns null (and logs why)
     * if the file cannot be used.
     */
    public static Rule parseRule(String fileName, String raw) {

        if (String.isBlank(raw)) {
            logSkip(fileName, 'the file is empty');
            return null;
        }

        // an editor may add a byte order mark, which breaks JSON.deserialize
        String bom = String.fromCharArray(new List<Integer>{ 65279 });
        String text = raw;
        if (text.startsWith(bom)) { text = text.substring(1); }

        Rule r;
        try {
            r = (Rule) JSON.deserialize(text, Rule.class);
        } catch (Exception e) {
            // also catches the old format, where a file held an array of rules
            logSkip(fileName, 'not valid JSON for a single rule - ' + e.getMessage());
            return null;
        }

        if (r == null || String.isBlank(r.message)) {
            logSkip(fileName, '"message" is missing or blank');
            return null;
        }
        if (r.policyRecords == null || r.policyRecords.isEmpty()) {
            logSkip(fileName, '"policyRecords" is missing or empty');
            return null;
        }

        r.name = fileName;
        return r;
    }

    private static void logSkip(String fileName, String reason) {
        System.debug(LoggingLevel.ERROR,
            'ContextualBanner - skipped ' + fileName + ': ' + reason);
    }
}
